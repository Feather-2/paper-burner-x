{
  "name": "paper-burner-root",
  "private": true,
  "type": "module",
  "exports": {
    "./agents/vfs": {
      "node": "./js/agents/vfs/index.node.js",
      "browser": "./js/agents/vfs/index.browser.js",
      "default": "./js/agents/vfs/index.js"
    },
    "./agents/runtime/transports": {
      "node": "./js/agents/runtime/transports/index.node.js",
      "browser": "./js/agents/runtime/transports/index.browser.js",
      "default": "./js/agents/runtime/transports/index.js"
    },
    "./agents/mcp": {
      "default": "./js/agents/mcp/index.js"
    },
    "./agents/mcp/transport": {
      "default": "./js/agents/mcp/transport-factory.js"
    },
    "./agents/runtime/core": {
      "default": "./js/agents/runtime/core/index.js"
    },
    "./agents/shared/platform": {
      "default": "./js/agents/shared/platform.js"
    }
  },
  "scripts": {
    "dev:fe": "vite",
    "build:fe": "vite build",
    "preview:fe": "vite preview",
    "test": "npm run test:agents && npm run test:ppt",
    "test:core": "vitest run tests/storage tests/annotations",
    "test:core:coverage": "vitest run tests/storage tests/annotations --coverage",
    "test:annotations:coverage": "vitest run tests/annotations --coverage",
    "test:vcr": "node --import ./tests/node-test-globals.mjs --test --test-concurrency=1 tests/vcr/vcr.smoke.test.js",
    "test:agents": "vitest run tests/agents --coverage",
    "test:ppt": "node --test tests/ppt/paste-document-modal.test.js tests/ppt/workflow-paste-text.test.js tests/ppt/workflow-design-stage.test.js tests/ppt/page-layout-brainstorm-panel.test.js tests/ppt/vditor-adapter.test.js tests/ppt/vditor-cdn.test.js tests/ppt/chatbot-intent.test.js tests/ppt/dsl-sync.test.js tests/ppt/editor/document.test.js tests/ppt/editor/history-manager.test.js tests/ppt/editor/esm-entry.test.js",
    "test:ppt:coverage": "node --test tests/ppt/paste-document-modal.test.js tests/ppt/workflow-paste-text.test.js tests/ppt/workflow-design-stage.test.js tests/ppt/vditor-adapter.test.js tests/ppt/vditor-cdn.test.js tests/ppt/chatbot-intent.test.js tests/ppt/dsl-sync.test.js --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 --test-coverage-include=js/ppt/generator/ppt_generator_utilities.js --test-coverage-include=js/ppt/generator/ppt_generator_editor.js --test-coverage-include=js/ppt/editor/intent/intent-parser.js",
    "test:ppt:coverage:page_layout": "node --test tests/ppt/page-layout-brainstorm-panel.test.js --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 --test-coverage-include=js/ppt/dashboard/ppt_dashboard_page_layout.js",
    "test:agents:shared": "vitest run --config vitest.shared.config.js",
    "test:agents:shared:coverage": "vitest run --config vitest.shared.config.js --coverage",
    "test:agents:prompts": "vitest run --config vitest.prompts.config.js",
    "test:agents:prompts:coverage": "vitest run --config vitest.prompts.config.js --coverage",
    "bench": "node --expose-gc benchmarks/runner.js",
    "postinstall": "echo 'No frontend build by default. Use npm run build:fe if needed.'"
  },
  "dependencies": {
    "animejs": "^3.2.2",
    "axios": "^1.7.9",
    "dagre": "^0.8.5",
    "dompurify": "^3.2.3",
    "file-saver": "^2.0.5",
    "graphlib": "^2.1.8",
    "js-base64": "^3.7.7",
    "katex": "^0.16.21",
    "markdown-it": "^14.1.0",
    "marked": "^15.0.6"
  },
  "optionalDependencies": {
    "quickjs-emscripten": "^0.31.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^27.4.0",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.12",
    "mammoth": "^1.10.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "terser": "^5.37.0",
    "tiktoken": "^1.0.22",
    "tree-sitter-wasms": "^0.1.13",
    "turndown": "^7.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "web-tree-sitter": "^0.26.3"
  }
}
